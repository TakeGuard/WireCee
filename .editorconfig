root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{c,h,inl,py}]
indent_size = 4

[*.{html,css,js,json}]
indent_size = 2

[*.{ps1,sln,vcxproj}]
end_of_line = crlf

[*.{sln,vcxproj}]
indent_style = tab

[Makefile]
indent_style = tab
